PORT=4000
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@college.local
ADMIN_PASSWORD=replace-before-use
COLLEGE_NAME=Smart College
TIMEZONE=Asia/Kolkata
SEND_TIME=09:00
SMS_MODE=demo
# textbee | fast2sms | phone | textbelt | smslocal
# textbee  = free 300/month, needs an Android phone linked in their app. Recommended.
# fast2sms = India, but the API is locked until a one-time Rs 100 recharge.
# textbelt = free key is blocked for India (works in some other countries).
# phone    = your own Android phone bridge on the local network.
SMS_PROVIDER=textbee
TEXTBELT_KEY=put-your-key-here
TEXTBELT_SENDER=Smart College
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
PHONE_GATEWAY_URL=http://192.168.1.50:8080
PHONE_GATEWAY_TOKEN=
PHONE_GATEWAY_DELAY_MS=1200
PHONE_GATEWAY_TIMEOUT_MS=30000
SMSLOCAL_API_KEY=
SMSLOCAL_ROUTE=1
SMSLOCAL_SENDER_ID=
SMSLOCAL_DLT_TEMPLATE_ID=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID=
CLIENT_ORIGIN=http://localhost:5173
